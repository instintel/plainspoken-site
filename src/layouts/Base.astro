---
import '../styles/tokens.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Private MVP: kept out of search results until this is ready to be public -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — PLAINspoken</title>
  </head>
  <body>
    <header class="container" style="padding-top: var(--space-4); padding-bottom: var(--space-3); border-bottom: 1px solid var(--color-rule);">
      <span class="eyebrow">PLAINspoken</span>
    </header>
    <main>
      <slot />
    </main>
    <footer class="container" style="padding: var(--space-5) var(--space-3); color: var(--color-ink-50); font-size: 14px;">
      Private build — not for public distribution.
    </footer>
  </body>
</html>
