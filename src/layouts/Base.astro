---
import '../styles/tokens.css';
import { SITE, absoluteUrl } from '../site.config';

interface Props {
  title: string;
  description?: string;
  image?: string; // site path such as /images/..., or a full URL
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, image, ogType = 'website', publishedTime, modifiedTime, jsonLd } = Astro.props;

const metaDescription = description ?? SITE.defaultDescription;
const canonical = absoluteUrl(Astro.url.pathname);
const hasImage = !!image && (image.startsWith('/') || image.startsWith('http'));
const imageUrl = hasImage ? (image!.startsWith('http') ? image : absoluteUrl(image!)) : undefined;
const pageTitle = title === 'Home' ? `${SITE.name}: Malaysia's money, plainly explained` : `${title} | ${SITE.name}`;
const ldBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {SITE.indexable
      ? <meta name="robots" content="index, follow, max-image-preview:large" />
      : <meta name="robots" content="noindex, nofollow" />}
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title === 'Home' ? pageTitle : title} />
    <meta property="og:description" content={metaDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {ldBlocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@600&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin>
    <link href="https://api.fontshare.com/v2/css?f[]=sentient@400,500&f[]=switzer@400,500,600&display=swap" rel="stylesheet">
  </head>
  <body>
    <header class="container site-header">
      <a href="/" class="ps-mark"><span class="ps-mark__word">plainspoken<span class="ps-mark__dot">.</span></span></a>
    </header>
    <nav class="site-nav" aria-label="Sections">
      <a href="/daily-briefs/" aria-current={path.startsWith('/daily-briefs') ? 'page' : undefined}>Daily Briefs</a>
      <a href="/explainers/" aria-current={path.startsWith('/explainers') ? 'page' : undefined}>Explainers</a>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="container" style="padding: var(--space-5) var(--space-3); color: var(--color-ink-50); font-size: 14px;">
      {SITE.indexable ? `© ${new Date().getFullYear()} ${SITE.name}` : 'Private build — not for public distribution.'}
    </footer>
  </body>
</html>
