---
import '../styles/tokens.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Private MVP: kept out of search results until this is ready to be public -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — PLAINspoken</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@600&display=swap" rel="stylesheet">
  </head>
  <body>
<header class="container" style="background: #17140F; max-width: var(--container-narrow); padding-top: var(--space-5); padding-bottom: var(--space-5); display: flex; justify-content: center; border-bottom: 1px solid var(--color-rule);">      <a href="/" class="ps-mark" aria-label="Plainspoken — home">
  <span class="ps-mark__word">plainspoken<span class="ps-mark__dot">.</span></span>
</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="container" style="padding: var(--space-5) var(--space-3); color: var(--color-ink-50); font-size: 14px;">
      Private build — not for public distribution.
    </footer>
  </body>
</html>
