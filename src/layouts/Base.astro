---
import '../styles/tokens.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Private MVP: kept out of search results until this is ready to be public -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — PLAINspoken</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@600&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
<link rel="preconnect" href="https://api.fontshare.com" crossorigin>
<link href="https://api.fontshare.com/v2/css?f[]=sentient@400,500&f[]=switzer@400,500,600&display=swap" rel="stylesheet">
  </head>
  <body>
<header class="container site-header">
      <a href="/" class="ps-mark"><span class="ps-mark__word">plainspoken<span class="ps-mark__dot">.</span></span></a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="container" style="padding: var(--space-5) var(--space-3); color: var(--color-ink-50); font-size: 14px;">
      Private build — not for public distribution.
    </footer>
  </body>
</html>
