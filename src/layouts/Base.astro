---
import '../styles/tokens.css';
import { SITE, absoluteUrl } from '../site.config';

interface Props {
  title: string;
  description?: string;
  image?: string; // site path such as /images/..., or a full URL
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, image, ogType = 'website', publishedTime, modifiedTime, jsonLd } = Astro.props;

const metaDescription = description ?? SITE.defaultDescription;
const canonical = absoluteUrl(Astro.url.pathname);
const hasImage = !!image && (image.startsWith('/') || image.startsWith('http'));
const imageUrl = hasImage ? (image!.startsWith('http') ? image : absoluteUrl(image!)) : undefined;
const pageTitle = title === 'Home' ? `${SITE.name}: From Wall Street to Wallet Street, Making Sens of the World's Money` : `${title} | ${SITE.name}`;
const ldBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    {SITE.indexable
      ? <meta name="robots" content="index, follow, max-image-preview:large" />
      : <meta name="robots" content="noindex, nofollow" />}
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title === 'Home' ? pageTitle : title} />
    <meta property="og:description" content={metaDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {ldBlocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Public+Sans:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600&display=swap" rel="stylesheet">
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a href="/" class="ps-mark" aria-label="Plainspoken home"><span class="ps-mark__square" aria-hidden="true"></span><span class="ps-mark__word">Plainspoken</span></a>
        <nav class="site-nav" aria-label="Sections">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
          <a href="/daily-briefs/" aria-current={path.startsWith('/daily-briefs') ? 'page' : undefined}>Daily Briefs</a>
          <a href="/explainers/" aria-current={path.startsWith('/explainers') ? 'page' : undefined}>Explainers</a>
          <a href="/budget/" aria-current={path.startsWith('/budget') ? 'page' : undefined}>Budget</a>
          <a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>About Us</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <a href="/" class="ps-mark ps-mark--small" aria-label="Plainspoken home"><span class="ps-mark__square" aria-hidden="true"></span><span class="ps-mark__word">Plainspoken</span></a>
        <span class="site-footer__tagline">From Wall Street to Wallet Street, Making Sens of the World's Money.</span>
        {SITE.indexable && <span class="site-footer__copy">{`© ${new Date().getFullYear()} ${SITE.name}`}</span>}
      </div>
    </footer>
  </body>
</html>
