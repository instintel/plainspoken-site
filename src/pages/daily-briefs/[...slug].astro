---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const briefs = await getCollection('daily-briefs');
  return briefs.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'daily-briefs'> };
const { Content } = await entry.render();
---
<Base title={entry.data.title}>
  <div class="container" style="padding-top: var(--space-4);">
    <a href="/" class="back-link">← Back to Daily Briefs</a>
  </div>
  <article class="container prose" style="padding: var(--space-6) 0;">
    <span class="eyebrow">Daily Brief · {entry.data.date.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).replace(',', '')}</span>
    <h1 class="display" style="font-size: 32px;">{entry.data.title}</h1>
    <Content />
  </article>
</Base>
