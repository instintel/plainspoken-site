---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { articleLd, breadcrumbLd, ldList, longDate } from '../../lib/seo';

export async function getStaticPaths() {
  const all = await getCollection('explainers');
  const published = all.filter((e) => !e.data.draft);
  const briefs = (await getCollection('daily-briefs'))
    .filter((b) => !b.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return all.map((entry) => {
    const key = entry.data.tags[0];
    // Daily Briefs that link to this explainer, or are tagged with its main tag
    const usedIn = briefs
      .filter((b) => b.body.includes(`/explainers/${entry.slug}/`) || (key && b.data.tags.includes(key)))
      .slice(0, 8);
    // Other explainers on the same topic or sharing a tag
    const related = published
      .filter((e) => e.slug !== entry.slug)
      .filter((e) => e.data.topic === entry.data.topic || e.data.tags.some((t) => entry.data.tags.includes(t)))
      .slice(0, 5);
    return { params: { slug: entry.slug }, props: { entry, usedIn, related } };
  });
}

const { entry, usedIn, related } = Astro.props as {
  entry: CollectionEntry<'explainers'>;
  usedIn: CollectionEntry<'daily-briefs'>[];
  related: CollectionEntry<'explainers'>[];
};
const { Content } = await entry.render();
const path = `/explainers/${entry.slug}/`;
const updated = entry.data.lastmod ?? entry.data.date;
---
<Base
  title={entry.data.title}
  description={entry.data.summary}
  ogType="article"
  publishedTime={entry.data.date}
  modifiedTime={updated}
  jsonLd={ldList(
    articleLd({
      kind: 'Article',
      path,
      title: entry.data.title,
      description: entry.data.summary,
      published: entry.data.date,
      modified: updated,
      author: entry.data.author,
      keywords: entry.data.tags,
    }),
    breadcrumbLd([
      { name: 'Home', path: '/' },
      { name: 'Explainers', path: '/explainers/' },
      { name: entry.data.title, path },
    ]),
  )}
>
  <div class="container" style="padding-top: var(--space-4);">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/explainers/">Explainers</a></nav>
  </div>
  <article class="container prose" style="padding-top: var(--space-5); padding-bottom: var(--space-6);">
    <span class="eyebrow">Explainer · {entry.data.topic}</span>
    <h1 class="display" style="font-size: 32px;">{entry.data.title}</h1>
    <Content />

    {usedIn.length > 0 && (
      <section class="related">
        <h2>In the Daily Brief</h2>
        <ul>
          {usedIn.map((b) => (
            <li><a href={`/daily-briefs/${b.slug}/`}>{b.data.title}</a> <span class="meta-date">{longDate(b.data.date)}</span></li>
          ))}
        </ul>
      </section>
    )}

    {related.length > 0 && (
      <section class="related">
        <h2>Related explainers</h2>
        <ul>
          {related.map((e) => (
            <li><a href={`/explainers/${e.slug}/`}>{e.data.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    <div style="margin-top: var(--space-5);">
      <a href="/explainers/" class="back-link">← All explainers</a>
    </div>
  </article>
</Base>
