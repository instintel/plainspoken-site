---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { breadcrumbLd, ldList } from '../../lib/seo';

// A to Z glossary. Each explainer is listed under the first letter of its short
// name (`term` in its front matter). When a page has no term, one is derived
// from its title: "What the OPR is, and ..." gives "OPR".
const termOf = (e: { slug: string; data: { title: string; term?: string } }) => {
  if (e.data.term) return e.data.term;
  const m = e.data.title.match(/^What (?:the )?(.+?) (?:is|means)\b/i);
  return m ? m[1] : e.slug.replace(/-/g, ' ').replace(/^./, (c) => c.toUpperCase());
};

const entries = (await getCollection('explainers'))
  .filter((e) => !e.data.draft)
  .map((e) => ({ e, term: termOf(e) }))
  .sort((a, b) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));

const letterOf = (term: string) => {
  const c = term.charAt(0).toUpperCase();
  return /[A-Z]/.test(c) ? c : '#';
};

const letters: { letter: string; items: typeof entries }[] = [];
for (const item of entries) {
  const letter = letterOf(item.term);
  const last = letters[letters.length - 1];
  if (last && last.letter === letter) last.items.push(item);
  else letters.push({ letter, items: [item] });
}

const description =
  "Plain explanations of the things that move Malaysia's economy and your money: interest rates, fuel prices, the ringgit, jobs, savings and the Budget.";
---
<Base
  title="Explainers: Malaysia's Money, Explained"
  description={description}
  jsonLd={ldList(breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Explainers', path: '/explainers/' }]))}
>
  <div class="container" style="padding-top: var(--space-4);">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › Explainers</nav>
  </div>
  <section class="container prose prose--article" style="padding-top: var(--space-5); padding-bottom: var(--space-6);">
    <span class="eyebrow">Explainers</span>
    <h1 class="display" style="font-size: 32px; margin: var(--space-2) 0 var(--space-2);">Malaysia's Money, Explained</h1>
    <p style="color: var(--color-ink-70); margin: 0 0 var(--space-4);">{description} Each page answers one question first, then shows what it means for you.</p>

    {entries.length === 0 && (
      <p style="color: var(--color-ink-50);">The first explainers are on their way.</p>
    )}

    {letters.length > 1 && (
      <nav class="glossary-index" aria-label="Jump to letter">
        {letters.map((g) => <a href={`#letter-${g.letter === '#' ? 'num' : g.letter}`}>{g.letter}</a>)}
      </nav>
    )}

    {letters.map((g) => (
      <div class="glossary-letter" id={`letter-${g.letter === '#' ? 'num' : g.letter}`}>
        <h2 class="glossary-letter__head">{g.letter}</h2>
        <dl class="glossary-list">
          {g.items.map(({ e, term }) => (
            <div class="glossary-entry">
              <dt><a href={`/explainers/${e.slug}/`}>{term}</a></dt>
              <dd>{e.data.summary}</dd>
            </div>
          ))}
        </dl>
      </div>
    ))}
  </section>
</Base>

<style>
  .glossary-index {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 var(--space-5);
    padding: var(--space-2) 0;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }
  .glossary-index a {
    min-width: 32px;
    padding: 4px 8px;
    text-align: center;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .glossary-index a:hover { color: var(--color-accent); }
  .glossary-letter { margin-bottom: var(--space-5); scroll-margin-top: var(--space-5); }
  .glossary-letter__head {
    font-family: var(--font-display);
    font-size: 28px;
    margin: 0 0 var(--space-2);
    padding-bottom: 4px;
    border-bottom: 2px solid var(--color-ink);
  }
  .glossary-list { margin: 0; }
  .glossary-entry { padding: var(--space-2) 0; border-bottom: 1px solid var(--color-rule); }
  .glossary-entry dt { margin: 0; }
  .glossary-entry dt a {
    text-decoration: none;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 500;
    line-height: 1.3;
  }
  .glossary-entry dt a:hover { color: var(--color-accent); }
  .glossary-entry dd { margin: 4px 0 0; color: var(--color-ink-70); font-size: 15px; }
</style>
