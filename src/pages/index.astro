---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allBriefs = (await getCollection('daily-briefs')).filter((b) => !b.data.draft);
const briefs = allBriefs.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [lead, ...rest] = briefs;
const secondary = rest.slice(0, 4);

const commentary = (await getCollection('commentary')).filter((c) => !c.data.draft);
const explainers = (await getCollection('explainers'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => (b.data.lastmod ?? b.data.date).valueOf() - (a.data.lastmod ?? a.data.date).valueOf())
  .slice(0, 6);

// Only treat real paths/URLs as images ("No image" in frontmatter means none)
const hasImage = (src?: string) => !!src && (src.startsWith('/') || src.startsWith('http'));
const shortDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
---
<Base title="Home">
<section class="container" style="padding-top: var(--space-4); padding-bottom: var(--space-1);">    <h1 class="display" style="font-size: 26px;">
      Institutional-grade market intelligence, for Malaysia's emerging & next generation leaders
    </h1>
  </section>

  <section class="container" style="padding-top: var(--space-2); padding-bottom: var(--space-6);">
    <span class="eyebrow">Daily Briefs</span>

    {!lead && (
      <p style="color: var(--color-ink-50);">
        No published briefs yet — this feed populates once the content engine writes
        approved markdown files into <code>src/content/daily-briefs/</code>.
      </p>
    )}

    {lead && (
      <div class="lead-brief">
        <div>
          <a href={`/daily-briefs/${lead.slug}/`} style="text-decoration: none; color: inherit;">
            <h2 class="display" style="font-size: 30px; line-height: 1.2; margin: 0 0 var(--space-2);">
              {lead.data.title}
            </h2>
          </a>
          {lead.data.summary && (
            <p style="color: var(--color-ink-70); font-size: 17px; margin: 0 0 var(--space-2);">
              {lead.data.summary}
            </p>
          )}
          <span class="meta-date">{shortDate(lead.data.date)}</span>
        </div>
        {hasImage(lead.data.image) && (
          <a href={`/daily-briefs/${lead.slug}/`}>
            <img src={lead.data.image} alt="" style="width: 100%; height: auto; border-radius: 4px; border: 1px solid var(--color-rule);" />
          </a>
        )}
      </div>
    )}

    {secondary.length > 0 && (
      <div>
        <span class="eyebrow" style="display: block; margin-bottom: var(--space-2);">More Daily Briefs</span>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-3);">
          {secondary.map((b) => (
            <a href={`/daily-briefs/${b.slug}/`} style="text-decoration: none; color: inherit;">
              {hasImage(b.data.image) && (
                <img src={b.data.image} alt="" style="width: 100%; height: auto; border-radius: 4px; border: 1px solid var(--color-rule); margin-bottom: var(--space-1);" />
              )}
              <strong style="display: block; font-size: 16px; line-height: 1.3; margin-bottom: 4px;">{b.data.title}</strong>
              <span class="meta-date">{shortDate(b.data.date)}</span>
            </a>
          ))}
        </div>
      </div>
            <div style="margin-top: var(--space-3);">
        <a href="/daily-briefs/" class="back-link">View all Daily Briefs →</a>
      </div>
    )}
  </section>

  {explainers.length > 0 && (
    <section class="container" style="padding-bottom: var(--space-6);">
      <span class="eyebrow">Explainers</span>
      <ul class="explainer-list" style="max-width: var(--container-narrow);">
        {explainers.map((e) => (
          <li>
            <a href={`/explainers/${e.slug}/`}>{e.data.title}</a>
            <p>{e.data.summary}</p>
          </li>
        ))}
      </ul>
      <div style="margin-top: var(--space-3);">
        <a href="/explainers/" class="back-link">View all explainers →</a>
      </div>
    </section>
  )}

  {commentary.length > 0 && (
    <section class="container" style="padding-bottom: var(--space-6);">
      <span class="eyebrow">Commentary</span>
      <ul style="list-style: none; padding: 0;">
        {commentary.map((c) => (
          <li class="card" style="margin-bottom: var(--space-2);">
            <a href={`/commentary/${c.slug}/`}><strong>{c.data.title}</strong></a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>