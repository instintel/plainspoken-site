---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allBriefs = (await getCollection('daily-briefs')).filter((b) => !b.data.draft);
const briefs = allBriefs.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [lead, ...rest] = briefs;
const secondary = rest.slice(0, 4);

const commentary = (await getCollection('commentary')).filter((c) => !c.data.draft);
---
<Base title="Home">
  <section class="container" style="padding: var(--space-6) 0;">
    <h1 class="display" style="font-size: 40px; max-width: 720px;">
      Institutional-grade market intelligence, built for people who allocate capital.
    </h1>
    <p class="prose" style="color: var(--color-ink-70); font-size: 19px;">
      PLAINspoken is the house track — daily briefs, deep commentary, and durable intelligence
      reports for the sophisticated reader. This is a private build; nothing here is public yet.
    </p>
  </section>

  <section class="container" style="padding-bottom: var(--space-6);">
    <span class="eyebrow">Daily Briefs</span>

    {!lead && (
      <p style="color: var(--color-ink-50);">
        No published briefs yet — this feed populates once the content engine writes
        approved markdown files into <code>src/content/daily-briefs/</code>.
      </p>
    )}

    {lead && (
      <div class="lead-brief">
        <div>
          <a href={`/daily-briefs/${lead.slug}/`} style="text-decoration: none; color: inherit;">
            <h2 class="display" style="font-size: 30px; line-height: 1.2; margin: 0 0 var(--space-2);">
              {lead.data.title}
            </h2>
          </a>
          {lead.data.summary && (
            <p style="color: var(--color-ink-70); font-size: 17px; margin: 0 0 var(--space-2);">
              {lead.data.summary}
            </p>
          )}
          <span style="font-family: var(--font-mono); font-size: 13px; color: var(--color-ink-50);">
            {lead.data.date.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).replace(',', '')}
          </span>
        </div>
        {lead.data.image && (
          <a href={`/daily-briefs/${lead.slug}/`}>
            <img src={lead.data.image} alt="" style="width: 100%; height: auto; border-radius: 4px; border: 1px solid var(--color-rule);" />
          </a>
        )}
      </div>
    )}

    {secondary.length > 0 && (
      <div>
        <span class="eyebrow" style="display: block; margin-bottom: var(--space-2);">More Daily Briefs</span>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-3);">
          {secondary.map((b) => (
            <a href={`/daily-briefs/${b.slug}/`} style="text-decoration: none; color: inherit;">
              {b.data.image && (
                <img src={b.data.image} alt="" style="width: 100%; height: 120px; object-fit: cover; border-radius: 4px; border: 1px solid var(--color-rule); margin-bottom: var(--space-1);" />
              )}
              <strong style="display: block; font-size: 16px; line-height: 1.3; margin-bottom: 4px;">{b.data.title}</strong>
              <span style="font-family: var(--font-mono); font-size: 12px; color: var(--color-ink-50);">
                {b.data.date.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).replace(',', '')}
              </span>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>

  <section class="container" style="padding-bottom: var(--space-6);">
    <span class="eyebrow">Commentary</span>
    {commentary.length === 0 && (
      <p style="color: var(--color-ink-50);">No published commentary yet.</p>
    )}
    <ul style="list-style: none; padding: 0;">
      {commentary.map((c) => (
        <li class="card" style="margin-bottom: var(--space-2);">
          <a href={`/commentary/${c.slug}/`}><strong>{c.data.title}</strong></a>
        </li>
      ))}
    </ul>
  </section>
</Base>