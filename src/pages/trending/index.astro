---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { breadcrumbLd, ldList } from '../../lib/seo';

const pieces = (await getCollection('trending'))
  .filter((t) => !t.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const hasImage = (src?: string) => !!src && (src.startsWith('/') || src.startsWith('http'));
const description = 'The money topics Malaysians are talking about, checked against the real numbers and rules, and what they mean for you.';
---
<Base
  title="Trending"
  description={description}
  jsonLd={ldList(breadcrumbLd([
    { name: 'Home', path: '/' },
    { name: 'Trending', path: '/trending/' },
  ]))}
>
  <div class="container" style="padding-top: var(--space-4);">
    <a href="/" class="back-link">← Back to Home</a>
  </div>
  <section class="container" style="padding-top: var(--space-5); padding-bottom: var(--space-6);">
    <span class="eyebrow">Trending</span>
    <h1 class="display" style="font-size: 32px; margin: var(--space-2) 0 var(--space-2);">What people are talking about, checked</h1>
    <p style="color: var(--color-ink-70); margin: 0 0 var(--space-4);">{description}</p>
    <ul style="list-style: none; padding: 0; margin: 0;">
      {pieces.map((t) => (
        <li style="padding: var(--space-3) 0; border-bottom: 1px solid var(--color-rule); display: flex; gap: var(--space-3); align-items: flex-start;">
          {hasImage(t.data.image) && (
            <a href={`/trending/${t.slug}/`} style="flex: 0 0 auto;" tabindex="-1" aria-hidden="true">
              <img src={t.data.image} alt="" loading="lazy" width="128" height="72" style="width: 128px; height: 72px; object-fit: cover; display: block;" />
            </a>
          )}
          <div style="min-width: 0;">
            <a href={`/trending/${t.slug}/`} style="text-decoration: none; color: var(--color-ink); font-size: 18px; font-weight: 500;">
              {t.data.title}
            </a>
            <p style="margin: var(--space-1) 0 0; color: var(--color-ink-70); font-size: 15px;">{t.data.summary}</p>
            <span class="meta-date">
              {t.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}
            </span>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>
